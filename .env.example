# production-rag — environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored and must never
# be committed. No real secrets in this file, ever.

APP_NAME=production-rag
APP_VERSION=0.1.0
ENVIRONMENT=local
LOG_LEVEL=INFO

# Qdrant connection. Inside docker compose this is http://qdrant:6333;
# from the host against the compose stack it is http://localhost:6333.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=production_rag

# LLM / embedding provider key. Leave empty here; set the real value only in
# your local, gitignored .env.
OPENAI_API_KEY=

HOST=0.0.0.0
PORT=8000
