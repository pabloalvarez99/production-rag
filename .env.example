# production-rag — environment template.
#
# Copy to .env and fill in the values you need:
#
#   cp .env.example .env                 # bash
#   Copy-Item .env.example .env          # PowerShell
#
# .env is gitignored AND dockerignored. This file is committed, so it must
# never contain a real value -- only names, shapes, and defaults.
#
# Precedence: configs/default.yaml < CONFIG_PATH profile < these variables.
# Docker Compose reads .env from the repository root automatically.

# --- Application -------------------------------------------------------------
APP_NAME=production-rag
APP_VERSION=0.1.0
# local | staging | production. Drives log format and safety defaults.
ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- HTTP server -------------------------------------------------------------
# 0.0.0.0 inside a container (127.0.0.1 would be unreachable from the host).
HOST=0.0.0.0
PORT=8000

# --- Vector store ------------------------------------------------------------
# Inside docker compose the hostname is the service name, NOT localhost.
#   compose : http://qdrant:6333
#   host    : http://localhost:6333
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=production_rag
# Only required for Qdrant Cloud; leave empty for the local container.
QDRANT_API_KEY=

# --- Model providers ---------------------------------------------------------
# Used for both embeddings and generation. Required before ingest or query;
# the API boots and serves /health without it.
OPENAI_API_KEY=

# Optional cross-encoder reranker (rerank.enabled is false by default).
# COHERE_API_KEY=

# --- Config ------------------------------------------------------------------
# Absolute path inside the container; compose mounts ./configs read-only.
CONFIG_PATH=/app/configs/default.yaml

# --- Observability (optional) ------------------------------------------------
# Tracing stays off until all three are set.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
